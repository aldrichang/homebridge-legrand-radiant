  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldrichang/homebridge-legrand-radiant.git"
  },
  "bugs": {
    "url": "https://github.com/aldrichang/homebridge-legrand-radiant/issues"
  },
  "engines": {
    "node": "^18.20.4 || ^20.15.1 || ^22",
    "homebridge": "^1.6.0 || ^2.0.0-beta.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "homebridge": "^1.7.0",
    "nodemon": "^3.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.3.0"
  },
  "homepage": "https://github.com/aldrichang/homebridge-legrand-radiant#readme"
